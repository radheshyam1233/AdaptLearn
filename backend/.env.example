# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is in .gitignore: it must never be pushed to GitHub.

# Local PostgreSQL started by docker compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptlearn

# Make your own: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Optional: leave empty to run without Redis caching
REDIS_URL=redis://localhost:6379/0

# Optional: leave empty to use the built-in fallback hints
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
